# CookDex is set up from its Settings page: the Mealie connection, AI keys,
# the optional database connection and everything else. This file is only for
# what the container needs before CookDex starts. You don't need it at all
# for a default install.

# ─── Docker image (for compose.ghcr.yml) ────────────────────────
COOKDEX_IMAGE=ghcr.io/thekannen/cookdex
# latest = newest stable release; beta = newest beta; edge = newest build from main
COOKDEX_TAG=latest

# ─── Where CookDex listens ──────────────────────────────────────
# WEB_BIND_PORT=4820          # Port (default 4820)
# WEB_BASE_PATH=/cookdex      # URL path prefix
# WEB_BIND_HOST=0.0.0.0       # Interface to bind

# ─── HTTPS / TLS ─────────────────────────────────────────────────
# WEB_SSL=true                # Default: on, with a self-signed certificate
                               # Set to false behind a reverse proxy that handles HTTPS
# WEB_SSL_CERTFILE=            # Your own certificate (PEM)
# WEB_SSL_KEYFILE=             # Your own private key (PEM)
# WEB_COOKIE_SECURE=           # Follows WEB_SSL; override only if sign-in cookies need it

# ─── Headless installs ──────────────────────────────────────────
# WEB_BOOTSTRAP_USER=admin    # Create the first owner on first start
# WEB_BOOTSTRAP_PASSWORD=     # (skips the setup page)
# MO_WEBUI_MASTER_KEY=        # Your own key for encrypting saved secrets
                               # (otherwise one is generated and kept in the data folder)

# ─── Older installs ─────────────────────────────────────────────
# Earlier versions read MEALIE_URL, MEALIE_API_KEY, AI keys and MEALIE_DB_* /
# MEALIE_PG_* database values from here. They still work: on first start
# CookDex copies them into Settings (secrets encrypted) and uses those from
# then on, so you can delete them from this file.
